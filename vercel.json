{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx convex deploy --cmd 'next build'",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "thinkshift-ai.com" }],
      "destination": "https://www.thinkshift-ai.com/:path*",
      "permanent": true
    }
  ]
}
